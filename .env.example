# IntegriEval Configuration Environment
# ====================================

# Security & Tokens (RNF-004, RNF-005)
SECRET_KEY=integrieval_super_secret_jwt_key_2026_info1197_secure_salt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# Database (SQLite by default, PostgreSQL ready)
DATABASE_URL=sqlite:///./integrieval.db

# Gmail SMTP Dispatch (RF-010, RI-002)
# Si se dejan vacíos, el sistema activa el simulador local registrando los enlaces en consola/interfaz sin costo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=integrieval@gmail.com
SMTP_ENABLED=false

# LLM Engine Provider (RI-001, RF-014, RNF-007)
# Opciones: mock (costo cero/offline), ollama, openai, anthropic
LLM_PROVIDER=mock
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30.0

# Server
HOST=127.0.0.1
PORT=8000
