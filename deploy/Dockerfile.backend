FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 INTEGRIEVAL_ENV_FILE=/app/config/.env
WORKDIR /app
COPY requirements-linux.txt ./
RUN pip install --no-cache-dir -r requirements-linux.txt
COPY backend ./backend
COPY tools ./tools
RUN groupadd -g 1000 app && useradd -u 1000 -g app app && mkdir -p /app/data/uploads /app/backups /app/config /app/frontend/static /app/frontend/templates && chown -R app:app /app
USER app
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "172.30.241.2", "--no-access-log", "--log-level", "warning"]
